// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(255)
  description String?     @db.Text
  price       Float
  salePrice   Float?
  imageUrl    String
  sizes       String?     @db.Text // JSON array of available sizes, e.g. ["S", "M", "L", "XL"]
  category    String?     @db.VarChar(100) // Category: Tops, Bottoms, Dresses, Coats & Puffers, Nightwear, Shoes
  brand       String?     @db.VarChar(100) // Brand name
  isSoldOut   Boolean     @default(false)
  isOnSale    Boolean     @default(false)
  stock       Int?
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@map("products")
}

model Order {
  id                      Int     @id @default(autoincrement())
  fullName                String
  instagramUsername       String
  address                 String
  city                    String
  phoneNumber             String
  totalPrice              Float
  postalFee               Float
  totalPriceWithPostalFee Float
  notes                   String?
  createdAt   DateTime    @default(now())

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int     @default(1)
  price     Float
  size      String?

  @@map("order_items")
}

/// A saved set of "new product" field values the admin can re-apply with one
/// click. Fields mirror Product, but every one is optional — a template only
/// prefills whatever the admin chose to store.
model ProductTemplate {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  description String?  @db.Text
  price       Float?
  salePrice   Float?
  category    String?  @db.VarChar(100)
  brand       String?  @db.VarChar(100)
  sizes       String?  @db.Text // JSON array of sizes
  stock       Int?
  isOnSale    Boolean  @default(false)
  isSoldOut   Boolean  @default(false)
  productName String?  @db.VarChar(255) // prefill for the product's own name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("product_templates")
}

/// A client review curated by the admin — either a text message (rendered as
/// a chat bubble) or a photo/screenshot. `clientName` is optional; when empty
/// the review displays as anonymous.
model Review {
  id         Int      @id @default(autoincrement())
  clientName String?  @db.VarChar(120)
  message    String?  @db.Text
  imageUrl   String?  @db.Text
  isVisible  Boolean  @default(true)
  sortOrder  Int      @default(0)
  /// Public submissions land as false and only go live once the admin
  /// approves them. Reviews the admin creates are approved on creation.
  isApproved Boolean  @default(false)
  /// Set for publicly submitted reviews; used for basic rate limiting.
  submitterIp String? @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("reviews")
}

model SiteSettings {
  id           Int      @id @default(1)
  heroImageUrl String?  @db.Text
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

